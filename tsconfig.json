{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"],
    // @intity/epub-js 0.3.103 gained an "exports" map with no "types" condition, which
    // hides the declarations its own "types" field points at (upstream issue 18). Point at
    // them directly, so the editor keeps real types instead of an implicit any.
    "paths": {
      "@intity/epub-js": ["./node_modules/@intity/epub-js/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
