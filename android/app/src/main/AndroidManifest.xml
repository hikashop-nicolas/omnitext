<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with": list Omnitext for the file types it can edit. content:// and
                 file:// are read natively (FileOpenerPlugin) and handed to the web app. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-httpd-php" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="image/x-dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/vnd.apple.pkpasses" />
                <data android:mimeType="application/smart-health-card" />
                <!-- The rest of what the formats declare (src/android-manifest.test.ts keeps them in step). -->
                <data android:mimeType="application/dicom" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/illustrator" />
                <data android:mimeType="application/json5" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/postscript" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/smil+xml" />
                <data android:mimeType="application/ttml+xml" />
                <data android:mimeType="application/ttxt+xml" />
                <data android:mimeType="application/vnd.apache.arrow.file" />
                <data android:mimeType="application/vnd.apache.parquet" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
                <data android:mimeType="application/vnd.ms-outlook" />
                <data android:mimeType="application/vnd.musescore" />
                <data android:mimeType="application/vnd.musescore+xml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.recordare.musicxml" />
                <data android:mimeType="application/vnd.recordare.musicxml+xml" />
                <data android:mimeType="application/vnd.shp" />
                <data android:mimeType="application/vnd.sqlite3" />
                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-guitar-pro" />
                <data android:mimeType="application/x-ipynb+json" />
                <data android:mimeType="application/x-lrc" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/x-tex" />
                <data android:mimeType="font/otf" />
                <data android:mimeType="font/ttf" />
                <data android:mimeType="font/woff" />
                <data android:mimeType="message/rfc822" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="x-gis/x-shapefile" />
                <!-- File managers report anything they do not recognise as this, which
                     is how a drawing usually arrives. Omnitext opens almost any file, so
                     offering it for an unknown one is honest rather than noise. -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- "Share to Omnitext" from another app. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-httpd-php" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="image/x-dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/vnd.apple.pkpasses" />
                <data android:mimeType="application/smart-health-card" />
                <!-- The rest of what the formats declare (src/android-manifest.test.ts keeps them in step). -->
                <data android:mimeType="application/dicom" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/illustrator" />
                <data android:mimeType="application/json5" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/postscript" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/smil+xml" />
                <data android:mimeType="application/ttml+xml" />
                <data android:mimeType="application/ttxt+xml" />
                <data android:mimeType="application/vnd.apache.arrow.file" />
                <data android:mimeType="application/vnd.apache.parquet" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
                <data android:mimeType="application/vnd.ms-outlook" />
                <data android:mimeType="application/vnd.musescore" />
                <data android:mimeType="application/vnd.musescore+xml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.recordare.musicxml" />
                <data android:mimeType="application/vnd.recordare.musicxml+xml" />
                <data android:mimeType="application/vnd.shp" />
                <data android:mimeType="application/vnd.sqlite3" />
                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-guitar-pro" />
                <data android:mimeType="application/x-ipynb+json" />
                <data android:mimeType="application/x-lrc" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/x-tex" />
                <data android:mimeType="font/otf" />
                <data android:mimeType="font/ttf" />
                <data android:mimeType="font/woff" />
                <data android:mimeType="message/rfc822" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="x-gis/x-shapefile" />
                <!-- File managers report anything they do not recognise as this, which
                     is how a drawing usually arrives. Omnitext opens almost any file, so
                     offering it for an unknown one is honest rather than noise. -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Several songs or videos shared at once play as one queue. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
